# v1.0 は PLAN のみ。他の値を指定すると起動を拒否します。
HEDGE_FUND_MODE=PLAN
# 本番: postgresql+psycopg://user:pass@localhost:5432/ai_hedge_fund
DATABASE_URL=sqlite:///./ai_hedge_fund.db
# claude | offline（offline は API キー不要のルールベース代替）
LLM_BACKEND=offline
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# 情報収集 Agent（STEP1）に Claude の web_search を許可するか
ENABLE_WEB_SEARCH=false
WEBHOOK_SECRET=change-me
ACCOUNT_BALANCE=1000000
ACCOUNT_CURRENCY=JPY
RISK_PER_TRADE_PCT=0.5
MAX_RISK_PER_TRADE_PCT=1.0
CURRENT_DRAWDOWN_PCT=0
# ANTHROPIC_API_KEY は環境変数で設定（このファイルに書かない）
